# 원본 PDF (저작권 — 출처는 data/sources.csv의 url 칸에만 기록)
data/raw/*
!data/raw/.gitkeep
*.pdf
*.[pP][dD][fF]
# 원본·라벨 묶음(zip) — PDF와 test2 정답이 들어 있을 수 있음
*.zip

# 학습 결과물 — 가중치·체크포인트만 제외하고 config.json·loss 로그는 커밋
runs/**/*.safetensors
runs/**/*.bin
runs/**/*.gguf
runs/**/checkpoint-*/

# 비밀키·환경
.env
.env.local
.venv/
venv/

# 파이썬 캐시
__pycache__/
*.pyc
.ipynb_checkpoints/
node_modules/

# IDE·OS
.vscode/settings.json
.idea/
.DS_Store

# Frontend build output
web/dist/

# NPU 트랙 — 병합 체크포인트·OpenVINO IR·컴파일 캐시 (merge.json·export_*.json만 커밋)
runs/**/merged/
runs/**/ov_*/
runs/_ov_cache/
